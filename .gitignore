*.aux
*.bbl
*.blg
*.log
*.out
*.spl
*.synctex.gz
*.fls
*.fdb_latexmk
*.lof
*.lot
*.toc
*.nav
*.snm
*.vrb
texput.log

# --- Python / vector DB ---
chroma_db/
__pycache__/
*.pyc
.venv/
venv/

# --- Obsidian ---
.obsidian/

# --- OS ---
.DS_Store
Thumbs.db

# --- Editor ---
.vscode/
.idea/
*.swp

# --- Arsip iterasi ---
arsip/

# --- Exclude lokal & rahasia (bawaan) ---
raw/*.html
.env

# --- PDF: track hanya final IEEE + baseline regresi ---
*.pdf
!makalah_pancasila_ieee.pdf
!tests/**/*.pdf
